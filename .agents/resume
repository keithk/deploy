#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

BUN_VERSION="1.3.14"
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

if ! command -v bun >/dev/null 2>&1; then
  echo "Bun is missing; rerun .agents/setup" >&2
  exit 1
fi

if [[ "$(bun --version)" != "$BUN_VERSION" ]]; then
  echo "Expected Bun $BUN_VERSION, found $(bun --version); rerun .agents/setup" >&2
  exit 1
fi

if [[ ! -d node_modules ]]; then
  echo "Dependencies are missing; rerun .agents/setup" >&2
  exit 1
fi

echo "Orb resumed with Bun $BUN_VERSION and installed dependencies."
