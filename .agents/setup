#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

BUN_VERSION="1.3.14"
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

run_step() {
  local label="$1"
  shift
  local started=$SECONDS
  printf '==> %s\n' "$label"
  "$@"
  printf '    completed in %ss\n' "$((SECONDS - started))"
}

install_system_packages() {
  local required=(ca-certificates curl git unzip)
  local missing=()
  local package

  for package in "${required[@]}"; do
    if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q 'ok installed'; then
      missing+=("$package")
    fi
  done

  if ((${#missing[@]} > 0)); then
    sudo apt-get update
    sudo apt-get install -y "${missing[@]}"
  else
    echo "    system packages already installed"
  fi
}

install_bun() {
  local installed=""
  if command -v bun >/dev/null 2>&1; then
    installed="$(bun --version)"
  fi

  if [[ "$installed" != "$BUN_VERSION" ]]; then
    curl -fsSL https://bun.sh/install | bash -s "bun-v${BUN_VERSION}"
  else
    echo "    Bun $BUN_VERSION already installed"
  fi

  if [[ "$(bun --version)" != "$BUN_VERSION" ]]; then
    echo "Expected Bun $BUN_VERSION, found $(bun --version)" >&2
    exit 1
  fi
}

persist_bun_path() {
  local profile="$HOME/.bash_profile"
  local marker="# deploy Bun toolchain"

  touch "$profile"
  if ! grep -Fqx "$marker" "$profile"; then
    cat >> "$profile" <<'EOF'

# deploy Bun toolchain
export BUN_INSTALL="$HOME/.bun"
case ":$PATH:" in
  *":$BUN_INSTALL/bin:"*) ;;
  *) export PATH="$BUN_INSTALL/bin:$PATH" ;;
esac
EOF
  fi
}

run_step "Checking system packages" install_system_packages
run_step "Installing Bun $BUN_VERSION" install_bun
run_step "Persisting Bun for login shells" persist_bun_path

if [[ ! -f .env && -f .env.example ]]; then
  cp -- .env.example .env
  echo "==> Created .env from .env.example"
else
  echo "==> Keeping existing .env"
fi

run_step "Installing workspace dependencies" bun install --frozen-lockfile
run_step "Building all workspace packages" bun run build:all

echo "Orb setup complete."
